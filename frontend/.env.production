# Frontend Environment Variables for Container Deployment

# API Configuration
# Use relative path so it goes through the gateway
VITE_API_BASE_URL=/api/v1

# Feature Flags
VITE_ENABLE_API_TASKS=true
VITE_ENABLE_DEBUG_MODE=false

# Build Configuration
NODE_ENV=production

# App Information
VITE_APP_NAME=Molecular Analysis Dashboard
VITE_APP_VERSION=1.0.0
