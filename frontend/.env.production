# Frontend Environment Variables for Container Deployment

# API Configuration
# Use relative path so it goes through the gateway
VITE_API_BASE_URL=/api/v1

# Feature Flags
VITE_ENABLE_API_TASKS=true
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_DEMO_AUTH=true
VITE_DEMO_USER_ID=00000000-0000-0000-0000-000000000000
VITE_DEMO_USER_EMAIL=demo@local.dev
VITE_DEMO_ORG_ID=demo-org
VITE_DEMO_USER_ROLES=admin

# Build Configuration
NODE_ENV=production

# App Information
VITE_APP_NAME=Molecular Analysis Dashboard
VITE_APP_VERSION=1.0.0
