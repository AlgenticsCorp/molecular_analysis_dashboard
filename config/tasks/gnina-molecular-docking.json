{
  "id": "gnina-molecular-docking",
  "adapter": {
    "module": "molecular_analysis_dashboard.adapters.providers.gnina_service_adapter",
    "class": "GninaServiceAdapter",
    "options": {
      "timeout_seconds": 120
    }
  },
  "metadata": {
    "name": "GNINA Molecular Docking",
    "description": "Perform molecular docking using the internal GNINA microservice",
    "version": "1.0.0",
    "category": "molecular-docking",
    "subcategory": "domestic",
    "tags": ["docking", "gnina", "protein-ligand"],
    "provider": "domestic",
    "provider_type": "domestic",
    "engine": "gnina",
    "status": "active",
    "interface_type": "rest",
    "parameters": [
      {
        "name": "receptor_file",
        "type": "file",
        "required": true,
        "description": "Protein receptor file (PDBQT or PDB format)",
        "validation": {
          "file_types": [".pdbqt", ".pdb"],
          "max_size_mb": 100
        }
      },
      {
        "name": "ligand_file",
        "type": "file",
        "required": true,
        "description": "Ligand file (SDF/MOL/MOL2 format)",
        "validation": {
          "file_types": [".sdf", ".mol2", ".mol"],
          "max_size_mb": 100
        }
      },
      {
        "name": "exhaustiveness",
        "type": "integer",
        "required": false,
        "default": 8,
        "description": "Exhaustiveness of the global search",
        "validation": {
          "min": 1,
          "max": 64
        }
      },
      {
        "name": "num_modes",
        "type": "integer",
        "required": false,
        "default": 9,
        "description": "Maximum number of binding modes to generate",
        "validation": {
          "min": 1,
          "max": 100
        }
      },
      {
        "name": "energy_range",
        "type": "number",
        "required": false,
        "default": 3,
        "description": "Energy range (kcal/mol) for the top poses",
        "validation": {
          "min": 0,
          "max": 12
        }
      },
      {
        "name": "seed",
        "type": "integer",
        "required": false,
        "description": "Random seed for deterministic docking runs",
        "validation": {
          "min": 0,
          "max": 999999999
        }
      },
      {
        "name": "cnn_scoring",
        "type": "string",
        "required": false,
        "default": "rescore",
        "description": "GNINA CNN scoring mode (none, rescore, refinement, all)",
        "validation": {
          "allowed_values": ["none", "rescore", "refinement", "all"]
        }
      },
      {
        "name": "scoring",
        "type": "string",
        "required": false,
        "description": "Override empirical scoring function (e.g., vina, vinardo)",
        "validation": {
          "allowed_values": ["vina", "vinardo", "ad4_scoring", "dkoes_fast", "dkoes_scoring"]
        }
      },
      {
        "name": "advanced_parameters",
        "type": "string",
        "required": false,
        "description": "JSON object of additional GNINA CLI options to forward to the service"
      },
      {
        "name": "job_name",
        "type": "string",
        "required": false,
        "default": "GNINA Docking",
        "description": "Friendly name for the docking job"
      },
      {
        "name": "note",
        "type": "string",
        "required": false,
        "default": "Internal GNINA execution",
        "description": "Optional note stored alongside the GNINA job"
      }
    ],
    "resource_requirements": {
      "cpu": "8",
      "memory": "16Gi",
      "gpu": "optional"
    },
    "execution_time_estimate": 1800,
    "source": "in-house"
  }
}
