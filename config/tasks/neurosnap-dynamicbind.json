{
  "id": "neurosnap-dynamicbind",
  "adapter": {
    "module": "molecular_analysis_dashboard.adapters.providers.neurosnap_task_adapter",
    "class": "NeuroSnapDynamicBindAdapter"
  },
  "metadata": {
    "name": "NeuroSnap DynamicBind",
    "description": "NeuroSnap DynamicBind docking with optional relaxation/noise controls and sampling parameters.",
    "version": "1.0.0",
    "category": "molecular-docking",
    "tags": ["dynamicbind", "neurosnap", "docking"],
    "provider": "neurosnap",
    "interface_type": "openapi",
    "parameters": [
      {
        "name": "job_name",
        "type": "string",
        "required": false,
        "default": "DynamicBind Docking",
        "description": "Human-readable name recorded with the execution."
      },
      {
        "name": "note",
        "type": "string",
        "required": false,
        "default": "Task framework execution",
        "description": "Optional note stored with the provider job."
      },
      {
        "name": "receptor_file",
        "type": "file",
        "required": true,
        "description": "Primary receptor structure file (PDB or PDBQT).",
        "validation": {
          "file_types": [".pdb", ".pdbqt"],
          "max_size_mb": 50
        }
      },
      {
        "name": "ligand_file",
        "type": "file",
        "required": false,
        "description": "Optional ligand file (SDF/MOL/PDB/PDBQT/SMILES).",
        "validation": {
          "file_types": [".sdf", ".mol", ".pdb", ".pdbqt", ".smiles", ".smi"],
          "max_size_mb": 25
        }
      },
      {
        "name": "ligand_entries_json",
        "type": "string",
        "required": false,
        "description": "JSON array of ligand descriptors (e.g., [{\"data\": \"C=C=C\", \"type\": \"smiles\"}])."
      },
      {
        "name": "number_samples",
        "type": "integer",
        "required": false,
        "default": 10,
        "description": "Number of samples (provider field: 'Number Samples').",
        "validation": {
          "min": 5,
          "max": 1000
        }
      },
      {
        "name": "inference_steps",
        "type": "integer",
        "required": false,
        "default": 20,
        "description": "Inference steps (provider field: 'Inference Steps').",
        "validation": {
          "min": 5,
          "max": 5000
        }
      },
      {
        "name": "model_version",
        "type": "string",
        "required": false,
        "default": "Version 2",
        "description": "Model version identifier (provider field: 'Model Version')."
      },
      {
        "name": "relax_structure",
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Include only when true (provider field: 'Relax Structure')."
      },
      {
        "name": "noise_structure",
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Include only when true (provider field: 'Noise Structure')."
      },
      {
        "name": "random_seed",
        "type": "integer",
        "required": false,
        "default": 0,
        "description": "Random seed (provider field: 'Random Seed').",
        "validation": {
          "min": 0,
          "max": 2147483647
        }
      }
    ],
    "resource_requirements": {
      "cpu": "8",
      "memory": "16Gi"
    },
    "execution_time_estimate": 3600,
    "source": "framework"
  }
}
