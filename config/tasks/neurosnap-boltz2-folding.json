{
  "id": "neurosnap-boltz2-folding",
  "adapter": {
    "module": "molecular_analysis_dashboard.adapters.providers.neurosnap_task_adapter",
    "class": "NeuroSnapBoltz2Adapter"
  },
  "metadata": {
    "name": "NeuroSnap Boltz-2 (AlphaFold3)",
    "description": "Run NeuroSnap's Boltz-2 (AlphaFold3) service for multi-chain folding with ligand and restraint support.",
    "version": "1.0.0",
    "category": "structure-prediction",
    "tags": ["alphafold3", "structure-prediction", "boltz-2"],
    "provider": "neurosnap",
    "interface_type": "openapi",
    "parameters": [
      {
        "name": "job_name",
        "type": "string",
        "required": false,
        "default": "Boltz-2 Folding",
        "description": "Human-readable name recorded with the execution."
      },
      {
        "name": "note",
        "type": "string",
        "required": false,
        "default": "Task framework execution",
        "description": "Optional note stored with the NeuroSnap job."
      },
      {
        "name": "sequences",
        "type": "string",
        "required": true,
        "description": "JSON array of sequence objects (e.g., [{\"name\": \"prot1\", \"sequence\": \"ACD...\", \"type\": \"aa|dna|rna\"}]) or FASTA-formatted text."
      },
      {
        "name": "molecules",
        "type": "string",
        "required": false,
        "description": "Optional JSON array of molecule descriptors: [{\"data\": \"SDF/SMILES text\", \"type\": \"smiles|sdf|mol|pdb\"}]."
      },
      {
        "name": "residue_modifications",
        "type": "string",
        "required": false,
        "description": "Residue modification instructions (e.g., protein_1:102:MLY)."
      },
      {
        "name": "msa_mode",
        "type": "string",
        "required": false,
        "default": "mmseqs2_uniref_env",
        "description": "MSA generation mode (mmseqs2_uniref_env or custom).",
        "validation": {
          "allowed_values": ["mmseqs2_uniref_env", "custom"]
        }
      },
      {
        "name": "number_recycles",
        "type": "integer",
        "required": false,
        "default": 6,
        "description": "Number of recycling iterations.",
        "validation": {
          "min": 1,
          "max": 20
        }
      },
      {
        "name": "sampling_steps",
        "type": "integer",
        "required": false,
        "default": 200,
        "description": "Number of sampling steps.",
        "validation": {
          "min": 1,
          "max": 1000
        }
      },
      {
        "name": "diffusion_samples",
        "type": "integer",
        "required": false,
        "default": 5,
        "description": "Number of diffusion samples.",
        "validation": {
          "min": 1,
          "max": 50
        }
      },
      {
        "name": "custom_msa_file",
        "type": "file",
        "required": false,
        "description": "Optional custom MSA file (A3M/STO/TXT).",
        "validation": {
          "file_types": [".a3m", ".sto", ".txt"],
          "max_size_mb": 25
        }
      },
      {
        "name": "molecule_file",
        "type": "file",
        "required": false,
        "description": "Optional ligand file (SDF/MOL/PDB/SMILES).",
        "validation": {
          "file_types": [".sdf", ".mol", ".pdb", ".smiles", ".smi"],
          "max_size_mb": 10
        }
      },
      {
        "name": "cyclic_biopolymers",
        "type": "string",
        "required": false,
        "description": "Comma-separated list of cyclic biopolymer sequence names."
      },
      {
        "name": "binder_sequence",
        "type": "string",
        "required": false,
        "description": "Sequence name acting as binder when pocket restraints are supplied."
      },
      {
        "name": "pocket_restraints",
        "type": "string",
        "required": false,
        "description": "Pocket restraint lines (e.g., target_chain:residue)."
      },
      {
        "name": "covalent_restraints",
        "type": "string",
        "required": false,
        "description": "Covalent restraint lines (SEQ_ID1:RES1:ATOM1:SEQ_ID2:RES2:ATOM2)."
      },
      {
        "name": "use_inference_time_potentials",
        "type": "boolean",
        "required": false,
        "description": "Enable inference-time potentials for Boltz-2 sampling."
      },
      {
        "name": "molecular_weight_correction",
        "type": "boolean",
        "required": false,
        "description": "Apply molecular weight correction during sampling."
      },
      {
        "name": "sampling_steps_affinity",
        "type": "integer",
        "required": false,
        "default": 200,
        "description": "Number of affinity sampling steps.",
        "validation": {
          "min": 1,
          "max": 1000
        }
      },
      {
        "name": "diffusion_samples_affinity",
        "type": "integer",
        "required": false,
        "default": 5,
        "description": "Number of affinity diffusion samples.",
        "validation": {
          "min": 1,
          "max": 50
        }
      },
      {
        "name": "step_scale",
        "type": "number",
        "required": false,
        "default": 1.5,
        "description": "Step scale applied during Boltz-2 sampling.",
        "validation": {
          "min": 0.1,
          "max": 5
        }
      }
    ],
    "resource_requirements": {
      "cpu": "24",
      "memory": "48Gi"
    },
    "execution_time_estimate": 5400,
    "source": "framework"
  }
}
